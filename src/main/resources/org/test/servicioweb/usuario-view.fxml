<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="548.0" prefWidth="765.0" spacing="10" style="-fx-background-color: #d7ffff;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.test.servicioweb.controller.UsuarioController">

    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

    <!-- Título -->
    <Label text="Consulta de usuarios - API REST">
        <font>
            <Font name="System Bold" size="16" />
        </font>
    </Label>

    <!-- Botón + mensaje de estado, uno al lado del otro -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button fx:id="btnConsultar" onAction="#consultarDatos" style="-fx-background-color: #c9729f;" text="Consultar usuarios" textFill="WHITE">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font></Button>
        <Label fx:id="lblUsuario" text="Presione Consultar usuarios">
         <font>
            <Font name="System Italic" size="12.0" />
         </font></Label>
    </HBox>

    <TableView fx:id="tblUsuarios" style="-fx-background-color: #e9f1dd;" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="ID" />
            <TableColumn fx:id="colNombre" text="Nombre" />
            <TableColumn fx:id="colUsername" text="Username" />
            <TableColumn fx:id="colEmail" text="Correo" />
            <TableColumn fx:id="colTelefono" text="Teléfono" />
            <TableColumn fx:id="colCiudad" text="Ciudad" />
            <TableColumn fx:id="colEmpresa" text="Empresa" />
        </columns>
    </TableView>
</VBox>
